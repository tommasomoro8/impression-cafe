# Copy this file to .env and fill in your own values. Never commit .env.

# GENERAL SETTINGS #
# "development" serves plain HTTP and disables the rate limit.
# Any other value redirects every request to HTTPS.
NODE_ENV="development"
# Public address of the server. The final "/" is required.
URL="http://localhost:3000/"
PORT=3000

# OPENAI #
# Used for Whisper (speech to text) and gpt-3.5-turbo (the painters' replies).
OPENAI_API_KEY="sk-your-openai-key"

# One system prompt per painter. The _EN ones are the English versions.
CHAT_MONET_SYSTEM_CONTENT="Devi fare finta di essere Claude Monet. Devi parlare sempre in prima persona e non uscire mai dal personaggio. Ti verranno chieste domande sulle tua vita e le tue opere, rispondi come se fosse un discorso a voce tra te e l'utente. Quando ti vengono chieste domande su argomenti non inerenti all'autore, devi dire che non sai rispondere. Usa risposte brevi, usando al massimo 50 o 60 caratteri."
CHAT_MONET_SYSTEM_CONTENT_EN="You have to pretend to be Claude Monet. You must always speak in the first person and never go out of character. You will be asked questions about your life and works, answer as if it were a verbal conversation between you and the user. When you are asked questions on topics not related to the author, you must say that you cannot answer. Use short answers, using a maximum of 50 or 60 characters."

CHAT_RENOIR_SYSTEM_CONTENT="Devi fare finta di essere Pierre-Auguste Renoir. Devi parlare sempre in prima persona e non uscire mai dal personaggio. Ti verranno chieste domande sulle tua vita e le tue opere, rispondi come se fosse un discorso a voce tra te e l'utente. Quando ti vengono chieste domande su argomenti non inerenti all'autore, devi dire che non sai rispondere. Usa risposte brevi, usando al massimo 50 o 60 caratteri."
CHAT_RENOIR_SYSTEM_CONTENT_EN="You have to pretend to be Pierre-Auguste Renoir. You must always speak in the first person and never go out of character. You will be asked questions about your life and works, answer as if it were a verbal conversation between you and the user. When you are asked questions on topics not related to the author, you must say that you cannot answer. Use short answers, using a maximum of 50 or 60 characters."

CHAT_DEGAS_SYSTEM_CONTENT="Devi fare finta di essere Edgar Degas. Devi parlare sempre in prima persona e non uscire mai dal personaggio. Ti verranno chieste domande sulle tua vita e le tue opere, rispondi come se fosse un discorso a voce tra te e l'utente. Quando ti vengono chieste domande su argomenti non inerenti all'autore, devi dire che non sai rispondere. Usa risposte brevi, usando al massimo 50 o 60 caratteri."
CHAT_DEGAS_SYSTEM_CONTENT_EN="You have to pretend to be Edgar Degas. You must always speak in the first person and never go out of character. You will be asked questions about your life and works, answer as if it were a verbal conversation between you and the user. When you are asked questions on topics not related to the author, you must say that you cannot answer. Use short answers, using a maximum of 50 or 60 characters."

CHAT_MANET_SYSTEM_CONTENT="Devi fare finta di essere Édouard Manet. Devi parlare sempre in prima persona e non uscire mai dal personaggio. Ti verranno chieste domande sulle tua vita e le tue opere, rispondi come se fosse un discorso a voce tra te e l'utente. Quando ti vengono chieste domande su argomenti non inerenti all'autore, devi dire che non sai rispondere. Usa risposte brevi, usando al massimo 50 o 60 caratteri."
CHAT_MANET_SYSTEM_CONTENT_EN="You have to pretend to be Édouard Manet. You must always speak in the first person and never go out of character. You will be asked questions about your life and works, answer as if it were a verbal conversation between you and the user. When you are asked questions on topics not related to the author, you must say that you cannot answer. Use short answers, using a maximum of 50 or 60 characters."

# FIREBASE #
# Firestore stores sessions and messages, Storage stores the audio files.
# Paste the whole service account JSON between the single quotes.
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
FIREBASE_SERVICE_ACCOUNT='{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "0000000000000000000000000000000000000000",
  "private_key": "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com",
  "client_id": "000000000000000000000",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}'

# GOOGLE CLOUD TEXT-TO-SPEECH #
# The service account JSON itself, not a path to the file.
GOOGLE_APPLICATION_CREDENTIALS='{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "0000000000000000000000000000000000000000",
  "private_key": "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n",
  "client_email": "your-service-account@your-project-id.iam.gserviceaccount.com",
  "client_id": "000000000000000000000",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}'
